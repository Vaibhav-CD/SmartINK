# SmartInk — local API key template (SAFE TO COMMIT).
# Copy to .env.local and fill in your real key. .env.local is gitignored
# and never pushed to GitHub.
#
#   cp .env.example .env.local
#
# Option B (no file at all): leave these blank and paste your key in-app
# via Meta Settings. That path stores only in browser localStorage.

# Meta Muse — default provider (project uses Meta throughout)
VITE_MUSE_API_KEY=
# Optional Muse overrides (defaults shown)
# VITE_MUSE_API_URL=https://api.meta.ai/v1
# VITE_MUSE_MODEL=muse-wonder-1.0
# Per-task routing via Meta Model API (one key, one model per job):
# VITE_MUSE_COPILOT_MODEL=muse-spark-1.3
# VITE_MUSE_PROOFS_MODEL=muse-wonder-1.0
# VITE_MUSE_TRANSLATION_MODEL=muse-spark-1.3
# VITE_MUSE_IMAGE_MODEL=muse-image-1.0
# VITE_MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# VITE_MUSE_SEGMENT_MODEL=sam-3.1
# VITE_MUSE_FALLBACK_MODEL=muse-glimmer
# Fallback chain after a hosted chat route fails:
# muse-spark-1.2 -> muse-glimmer -> muse-spark-open -> offline engine

# Fallback aliases (only used when no Muse key is set)
VITE_META_API_KEY=
VITE_LLAMA_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
# VITE_META_API_URL=https://api.groq.com/openai/v1
# VITE_META_MODEL=llama-3.3-70b-versatile
